t,{useEffect} from 'react';\r\nimport { useState } from \"react\"\r\nimport {Link} from 'react-scroll'\r\nimport './NavBar.css';\r\n\r\nconst Navbar=() => {\r\n  const [isNavExpanded, setIsNavExpanded] = useState(false);\r\n\r\n  return (\r\n    <div className = \"navbar\">\r\n\r\n        <div className = \"logo animate__animated animate__fadeInUp animate__delay-2s\">\r\n          <Link to='landing' spy={true} smooth={true}>\r\n            <img className = \"logoimg\"></img>\r\n          </Link>\r\n        </div>\r\n        \r\n        <div className=\"navigation animate__animated animate__fadeInUp animate__delay-2s\">\r\n            <div className = \"navElements\"><Link className = \"navA navAHover\" to='landing' spy={true} smooth={true}>Home</Link></div>\r\n            <div className = \"navElements\"><Link className = \"navA navAHover\" to='aboutMe' spy={true} smooth={true}>About</Link></div>\r\n            <div className = \"navElements\"><Link className = \"navA navAHover\" to='skills' spy={true} smooth={true}>Skills</Link></div>\r\n            <div className = \"navElements\"><Link className = \"navA navAHover\" to='projects' spy={true} smooth={true}>Projects</Link></div>\r\n            <div className = \"navElements\"><Link className = \"navA navAHover\" to='experience' spy={true} smooth={true}>Experience</Link></div>\r\n        </div>\r\n\r\n        <div className='collapsedNav animate__animated animate__fadeInUp animate__delay-2s'>\r\n          <button\r\n            className=\"hamburger\"\r\n            onClick={() => {\r\n              setIsNavExpanded(!isNavExpanded)\r\n            }}\r\n            >\r\n            <svg\r\n            xmlns=\"http://www.w3.org/2000/svg\"\r\n            className=\"h-5 w-5\"\r\n            viewBox=\"0 0 20 20\"\r\n            fill=\"orange\"\r\n            >\r\n              <path\r\n                fillRule=\"evenodd\"\r\n                d=\"M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM9 15a1 1 0 011-1h6a1 1 0 110 2h-6a1 1 0 01-1-1z\"\r\n                clipRule=\"evenodd\"\r\n              />\r\n            </svg>\r\n          </button>\r\n          <div className={isNavExpanded ? \"expanded\" : \"navigation-menu\"}>\r\n            <div className = \"navElements\"><Link className = \"navA navAHover\" to='landing' spy={true} smooth={true} onClick={() => {setIsNavExpanded(!isNavExpanded)}}>Home</Link></div>\r\n            <div className = \"navElements\" ><Link className = \"navA navAHover\" to='aboutMe'spy={true} smooth={true} onClick={() => {setIsNavExpanded(!isNavExpanded)}}>About</Link></div>\r\n            <div className = \"navElements\"><Link className = \"navA navAHover\" to='skills' spy={true} smooth={true} onClick={() => {setIsNavExpanded(!isNavExpanded)}}>Skills</Link></div>\r\n            <div className = \"navElements\"><Link className = \"navA navAHover\" to='projects' spy={true} smooth={true} onClick={() => {setIsNavExpanded(!isNavExpanded)}}>Projects</Link></div>\r\n            <div className = \"navElements\"><Link className = \"navA navAHover\" to='experience' spy={true} smooth={true} onClick={() => {setIsNavExpanded(!isNavExpanded)}}>Experience</Link></div>\r\n          </div>\r\n        </div>\r\n\r\n        </div>\r\n  )\r\n};\r\n\r\nexport default Navbar;","C:\\Users\\kavin\\Desktop\\Portfolio\\online-portfolio\\src\\Components\\Landing.js",["64","65"],"import './Landing.css';\r\nimport { Icon, InlineIcon } from '@iconify/react';\r\nimport heavyMultiplicationX from '@iconify-icons/emojione-monotone/heavy-multiplication-x';\r\nimport AOS from 'aos';\r\nimport 'aos/dist/aos.css';\r\nimport TypeAnimation from 'react-type-animation';\r\n\r\n\r\nfunction Landing(){\r\n    AOS.init();\r\n    return(\r\n        <div className = \"landing\">\r\n\r\n        <head>\r\n        <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css\"/>\r\n        <link rel=\"stylesheet\" href=\"bower_components/aos/dist/aos.css\" />\r\n        </head>\r\n        <script src=\"bower_components/aos/dist/aos.js\"></script> \r\n            <div className = \"column landingLeft\" id = \"leftSide\">\r\n                <img className = \"myPic animate__animated animate__fadeInUp animate__delay-2s\"></img>\r\n            </div>\r\n\r\n            <div className = \"column landingRight\" id  = \"rightSide\">\r\n                <div className = \"name animate__animated animate__fadeInUp animate__delay-2s\" data-aos=\"fade-up\" data-aos-duration=\"1000\"><h1>KAVINDYA ABEYSINGHE</h1></div>\r\n                <div className = \"frontend animate__animated animate__fadeInUp animate__delay-2s\" data-aos=\"fade-up\" data-aos-duration=\"1000\">\r\n                    <TypeAnimation\r\n                        cursor={true}\r\n                        sequence={[\r\n                        'Full-Stack Developer',\r\n                        2000,\r\n                        'Front-End Developer',\r\n                        2000,\r\n                        'Back-End Developer',\r\n                        2000,\r\n                        'Web Developer',\r\n                        2000,\r\n                        'Software Engineer',\r\n                        2000,\r\n                        ]}\r\n                        wrapper=\"label\"\r\n                        repeat={Infinity}\r\n                    />\r\n                </div>\r\n            </div>\r\n\r\n            <div className = \"plusSignL\"><div className = \"xSign\"><Icon icon={heavyMultiplicationX} color=\"orange\" rotate=\"90deg\" /></div></div>\r\n            <div className = \"plusSignRT\"><div className = \"xSign\"><Icon icon={heavyMultiplicationX} color=\"orange\" rotate=\"90deg\" /></div></div>\r\n            <div className = \"plusSignR\"><div className = \"xSign\"><Icon icon={heavyMultiplicationX} color=\"orange\" rotate=\"90deg\" /></div></div>\r\n            <div className = \"plusSignLB\"><div className = \"xSign\"><Icon icon={heavyMultiplicationX} color=\"orange\" rotate=\"90deg\" /></div></div>\r\n            \r\n        </div>\r\n    );\r\n}\r\n\r\nexport default Landing;","C:\\Users\\kavin\\Desktop\\Portfolio\\online-portfolio\\src\\Components\\AboutMe.js",["66"],"import './AboutMe.css';\r\nimport AOS from 'aos';\r\nimport 'aos/dist/aos.css';\r\n\r\nfunction AboutMe(){\r\n    AOS.init();\r\n    return(\r\n        <div className = \"aboutMe\">\r\n            <head>\r\n                <link rel=\"stylesheet\" href=\"bower_components/aos/dist/aos.css\" />\r\n            </head>\r\n            <script src=\"bower_components/aos/dist/aos.js\"></script> \r\n            <div className = \"column aboutMeLeft\" id = \"leftSide\">\r\n                <div className = \"line\">\r\n                    <hr data-aos=\"fade-up\" data-aos-duration=\"1000\" className = \"vertLine aboutMeLine\" width = \"1\" size = \"170\"></hr>\r\n                </div>\r\n                <div className = \"deets\">\r\n                    <div data-aos=\"fade-up\" data-aos-duration=\"1000\" className = \"titleAbout\"><h1 className = \"aboutMeText\">ABOUT ME</h1></div>\r\n                    <img data-aos=\"fade-up\" data-aos-duration=\"1000\" className = \"aboutImg\"></img>\r\n                </div>\r\n            </div>\r\n\r\n            <div className = \"column\" id = \"rightSide\">\r\n                <div data-aos=\"fade-up\" data-aos-duration=\"1000\" className = \"aboutText\">\r\n                    <p>Hey there! I’m Kavindya, an IT graduate from the Royal Melbourne Institute of Technology, currently with almost 2 years of experience. As my time as a full stack developer, I mainly worked \r\n                    on the payments team, and while my primary interest is front-end development I focused on seamlessly connecting robust GraphQL and ASP.NetCore back-end infrastructure with React front-end.</p>\r\n                    <p>A bit about myself, I’m very much a team player and love getting to know new people and share my experiences with them and hearing their experiences and points of views as well. \r\n                    New perspectives fascinate me, and I love looking at things through these different perspectives, which helps me with the designing process that is very important for UI design.</p>\r\n                    <p>My work ethic is simple. I simply will not rest, till my responsibilities have been fulfilled, regardless of how daunting the task may be. Willing to take up all types of challenges, \r\n                    I consider taking responsibility and reliability the two biggest pillars of my success so far, when working in and amongst a team.\r\n                    </p>\r\n                </div>\r\n            </div>\r\n        </div> \r\n        \r\n    );\r\n}\r\n\r\nexport default AboutMe;","C:\\Users\\kavin\\Desktop\\Portfolio\\online-portfolio\\src\\Components\\MainPage.js",[],"C:\\Users\\kavin\\Desktop\\Portfolio\\online-portfolio\\src\\Components\\Skills.js",["67","68","69","70","71","72","73","74","75"],"import './Skills.css';\r\nimport reactImg from '../logo512.png';\r\nimport angularImg from '../angular.png';\r\nimport nativeImg from '../react-native.png';\r\nimport java from '../java.png';\r\nimport python from '../python.png';\r\nimport mysql from '../sql.png';\r\nimport android from '../android-logo.svg';\r\nimport git from '../git.png';\r\nimport photoshop from '../photoshop.png';\r\n\r\n\r\nfunction Skills(){\r\n    return(\r\n        <div className = \"skills\">\r\n            <div><h1 className = \"decorated\" ><span>SKILLS</span></h1></div>\r\n            <div className = \"skillsBox\">\r\n                <div className = \"row\">\r\n                    <div className = \"react\">\r\n                        <img className = \"reactImgRotate\" src = {reactImg}></img>\r\n                        <div className = \"skillTitle\">React</div>\r\n                    </div>\r\n                    <div className = \"react\">\r\n                        <img className = \"reactImg\" src = {angularImg}></img>\r\n                        <div className = \"skillTitle\">Angular</div>\r\n                    </div>\r\n                    <div className = \"react\">\r\n                        <img className = \"reactImg\" src = {nativeImg}></img>\r\n                        <div className = \"skillTitle\">React Native</div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div className = \"row\">\r\n                    <div className = \"react\">\r\n                        <img className = \"reactImg\" src = {java}></img>\r\n                        <div className = \"skillTitle\">Java</div>\r\n                    </div>\r\n                    <div className = \"react\">\r\n                        <img className = \"reactImg\" src = {python}></img>\r\n                        <div className = \"skillTitle\">Python</div>\r\n                    </div>\r\n                    <div className = \"react\">\r\n                        <img className = \"reactImg\" src = {mysql}></img>\r\n                        <div className = \"skillTitle\">MySQL</div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div className = \"row\">\r\n                    <div className = \"react\">\r\n                        <img className = \"reactImg\" src = {android}></img>\r\n                        <div className = \"skillTitle\">Android</div>\r\n                    </div>\r\n                    <div className = \"react\">\r\n                        <img className = \"reactImg\" src = {git}></img>\r\n                        <div className = \"skillTitle\">Git</div>\r\n                    </div>\r\n                    <div className = \"react\">\r\n                        <img className = \"reactImg\" src = {photoshop}></img>\r\n                        <div className = \"skillTitle\">Photoshop</div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default Skills;",["76","77"],"C:\\Users\\kavin\\Desktop\\Portfolio\\online-portfolio\\src\\Components\\Skills2.js",["78","79","80","81","82","83","84","85","86","87","88","89","90","91"],"import './AboutMe.css';\r\nimport './Skills.css';\r\nimport AOS from 'aos';\r\nimport 'aos/dist/aos.css';\r\nimport reactImg from '../KAvin react.png';\r\nimport nativeImg from '../react-native.png';\r\nimport python from '../python.png';\r\nimport mysql from '../sql.png';\r\nimport git from '../git.png';\r\nimport photoshop from '../photoshop.png';\r\nimport express from '../express.png';\r\nimport asp from '../asp.png';\r\nimport mongo from '../mongodb.png';\r\nimport java from '../java.png';\r\nimport graphql from '../graphql.png';\r\nimport azure from '../azure.png';\r\nimport nextjs from '../nextjs.png';\r\n\r\nfunction Skills2(){\r\n    AOS.init();\r\n    return(\r\n        <div className = \"skills\">\r\n            <head>\r\n                <link rel=\"stylesheet\" href=\"bower_components/aos/dist/aos.css\" />\r\n            </head>\r\n            <script src=\"bower_components/aos/dist/aos.js\"></script> \r\n            <div className = \"column\" id = \"leftSide\">\r\n                <div className = \"skillsBox\">\r\n                    <div className = \"row mobileRow\" data-aos=\"fade-up\" data-aos-duration=\"1000\">\r\n                        <div className = \"react\">\r\n                            <img className = \"reactImgRotate\" src = {reactImg}></img>\r\n                            <div className = \"skillTitle\">React</div>\r\n                        </div>\r\n                        <div className = \"react\">\r\n                            <img className = \"reactImg\" src = {graphql}></img>\r\n                            <div className = \"skillTitle\">GraphQL</div>\r\n                        </div>\r\n                        <div className = \"react\">\r\n                            <img className = \"reactImg\" src = {asp}></img>\r\n                            <div className = \"skillTitle\">ASP.NET Core</div>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div className = \"row mobileRow\" data-aos=\"fade-up\" data-aos-duration=\"1000\">\r\n                        <div className = \"react\">\r\n                            <img className = \"reactImg\" src = {nextjs}></img>\r\n                            <div className = \"skillTitle\">Next.js</div>\r\n                        </div>\r\n                        <div className = \"react\">\r\n                            <img className = \"reactImg\" src = {python}></img>\r\n                            <div className = \"skillTitle\">Python</div>\r\n                        </div>\r\n                        <div className = \"react\">\r\n                            <img className = \"reactImg\" src = {mysql}></img>\r\n                            <div className = \"skillTitle\">MySQL</div>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div className = \"row mobileRow\" data-aos=\"fade-up\" data-aos-duration=\"1000\">\r\n                        <div className = \"react\">\r\n                            <img className = \"reactImg\" src = {azure}></img>\r\n                            <div className = \"skillTitle\">Azure</div>\r\n                        </div>\r\n                        <div className = \"react\">\r\n                            <img className = \"reactImg\" src = {git}></img>\r\n                            <div className = \"skillTitle\">Git</div>\r\n                        </div>\r\n                        <div className = \"react\">\r\n                            <img className = \"reactImg\" src = {java}></img>\r\n                            <div className = \"skillTitle\">Java</div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <div className = \"column mobileRight\" id = \"rightSide\">\r\n                \r\n                <div className = \"line\">\r\n                    <hr data-aos=\"fade-up\" data-aos-duration=\"1000\" className = \"vertLine skillsLine\" width = \"1\" size = \"170\"></hr>\r\n                </div>\r\n                <div className = \"deets\">\r\n                    <div data-aos=\"fade-up\" data-aos-duration=\"1000\" className = \"titleAbout\"><h1 className = \"aboutMeText\">SKILLS</h1></div>\r\n                    <img data-aos=\"fade-up\" data-aos-duration=\"1000\" className = \"aboutImg\"></img>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        \r\n    );\r\n}\r\n\r\nexport default Skills2;","C:\\Users\\kavin\\Desktop\\Portfolio\\online-portfolio\\src\\Components\\Projects.js",["92"],"import './AboutMe.css';\r\nimport './Projects.css'\r\nimport AOS from 'aos';\r\nimport 'aos/dist/aos.css';\r\n\r\nfunction Projects(){\r\n    AOS.init();\r\n    return(\r\n        <div className = \"projects\">\r\n            <head>\r\n                <link rel=\"stylesheet\" href=\"bower_components/aos/dist/aos.css\" />\r\n            </head>\r\n            <script src=\"bower_components/aos/dist/aos.js\"></script> \r\n            <div className='projectData'>\r\n                <div className = \"projectRow mobileProject\">\r\n                    <div className = \"line\">\r\n                        <hr data-aos=\"fade-up\" data-aos-duration=\"1000\" className = \"projectVertLine\" width = \"1\" size = \"170\"></hr>\r\n                    </div>\r\n                    <div className = \"deets\">\r\n                        <div data-aos=\"fade-up\" data-aos-duration=\"1000\" className = \"titleAbout\"><h1 className = \"aboutMeText\">PROJECTS</h1></div>\r\n                        <img data-aos=\"fade-up\" data-aos-duration=\"1000\" className = \"aboutImg\"></img>\r\n                    </div>\r\n                </div>\r\n\r\n                <div className = \"projectRow\">\r\n                    <div data-aos=\"fade-up\" data-aos-duration=\"1000\" className = \"projectText\">\r\n\r\n                        <div className='btn hvr-grow'>\r\n                            <span></span>\r\n                            <h2>Vibe Check</h2>\r\n                            <p>A Social Network for university students to interact with each other during the COVID-19 pandemic. \r\n                            Students can sign up and login to share their thoughts and share pictures alongside. Furthermore, just \r\n                            like any social network, users can like and dislike other users’ posts and follow and unfollow other users\r\n                            as well. </p>\r\n                            <a className='redirect redirectHover' href='https://github.com/rmit-fwp-s2-2021/vibe-check-s3756717' target=\"_blank\" rel=\"noopener noreferrer\">Go to Github</a>\r\n                            \r\n\r\n                            \r\n                        </div>\r\n                        <br></br>\r\n                        <br></br>\r\n                        <br></br>\r\n                        <br></br>\r\n\r\n                        <div className='btn hvr-grow'>\r\n                            <span></span>\r\n                            <h2>CarShareScheme</h2>\r\n                            <p>Car renting made ever so easy. CarShareScheme was made as part of my Final Year Project, where I was in charge of \r\n                            designing and developing the front end of the Web Application. CarShareScheme allows users to book a vehicle within their \r\n                            vicinity, based on their liking and get directions to it using Google maps. Vehicles can be used for the period they have booked it \r\n                            for, after which they must return the vehicle by stopping the vehicle in a safe area and ending their trip in order to make their \r\n                            payment through a medium they prefer.</p>\r\n                            <a className='redirect redirectHover' href='https://github.com/kavinrahal/PP1-MON1630-Team6' target=\"_blank\" rel=\"noopener noreferrer\">Go to Github</a>\r\n                            \r\n                        </div>\r\n                        <br></br>\r\n                        <br></br>\r\n                        <br></br>\r\n                        <br></br>\r\n\r\n                        <div className='btn hvr-grow'>\r\n                            <span></span>   \r\n                            <h2>AGME</h2>\r\n                            <p>AGME is a booking system that allows customers to sign up to and create bookings for a particular business that is registered. \r\n                            Users can sign up to access all kinds of product and service providers, ranging from vehicle repairs to hair stylists. \r\n                            They can make a booking for an upcoming date, depending on the availability of the service and also choose the employee \r\n                            they prefer to do the service for them. Subsequently, the employee’s and the business’ schedules are updated. \r\n                            Business Owners also have the freedom to manage their employees and assign working hours.  </p>\r\n                            <a className='redirect redirectHover' href='https://github.com/isys1118-sef2020/team-project-mk-pacga' target=\"_blank\" rel=\"noopener noreferrer\">Go to Github</a>\r\n                            \r\n                        </div>\r\n                        <br></br>\r\n                        <br></br>\r\n                        <br></br>\r\n                        <br></br>\r\n\r\n                        <div className='btn hvr-grow'>\r\n                            <span></span>\r\n                            <h2>IMBD</h2>\r\n                            <p>IMBD contains information about various movies, actors, and other information about various programs available on the database.\r\n                            Users can sign up and view information about any movie on the website. Admins can manage any entry made into the website by adding, \r\n                            removing or editing information about any movie or actor.</p>\r\n                            <a className='redirect redirectHover' href='https://github.com/RMIT-SEPT/majorproject-8-mon-17-30-5' target=\"_blank\" rel=\"noopener noreferrer\">Go to Github</a>\r\n                            \r\n                        </div>\r\n                        <br></br>\r\n                    </div>\r\n                </div>            \r\n            </div>\r\n            \r\n        </div>\r\n        \r\n    );\r\n}\r\n\r\nexport default Projects;","C:\\Users\\kavin\\Desktop\\Portfolio\\online-portfolio\\src\\Components\\Experience.js",["93","94","95"],"C:\\Users\\kavin\\Desktop\\Portfolio\\online-portfolio\\src\\Components\\More.js",["96","97","98","99"],"import './AboutMe.css';\r\nimport './Projects.css'\r\nimport './More.css'\r\nimport AOS from 'aos';\r\nimport 'aos/dist/aos.css';\r\nimport linkedIn from '../linkedin.png';\r\nimport gitHub from '../github.png';\r\nimport facebook from '../facebook.png';\r\nimport instagram from '../instagram.png';\r\n\r\nfunction More(){\r\n    AOS.init();\r\n    return(\r\n        <div className='more'>\r\n            <head>\r\n                <link rel=\"stylesheet\" href=\"bower_components/aos/dist/aos.css\" />\r\n            </head>\r\n            <script src=\"bower_components/aos/dist/aos.js\"></script> \r\n            <div className='moreData' data-aos=\"fade-up\" data-aos-duration=\"1000\">\r\n                <h1 className = \"aboutMeText\">Want to know more?</h1>\r\n                <br></br>\r\n                <br></br>\r\n                <div className = \"linksRow\">\r\n                    <a href = \"https://www.linkedin.com/in/kavinrahal/\" target=\"_blank\" rel=\"noopener noreferrer\"><img className='logoImg' src = {linkedIn}/></a>\r\n                    <a href = \"https://github.com/kavinrahal\" target=\"_blank\" rel=\"noopener noreferrer\"><img className='logoImg' src = {gitHub}/></a>\r\n                    <a href = \"https://www.facebook.com/kavindya.abeysinghe.1/\" target=\"_blank\" rel=\"noopener noreferrer\"><img className='logoImg' src = {facebook}/></a>\r\n                    <a href = \"https://www.instagram.com/freeekonaleash/\" target=\"_blank\" rel=\"noopener noreferrer\"><img className='logoImg' src = {instagram}/></a>\r\n                </div>\r\n                <p className='rights'>© Kavindya Abeysinghe 2024. All rights reserved.</p>\r\n            </div>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default More;",{"ruleId":"100","replacedBy":"101"},{"ruleId":"102","replacedBy":"103"},{"ruleId":"104","severity":1,"message":"105","line":1,"column":15,"nodeType":"106","messageId":"107","endLine":1,"endColumn":24},{"ruleId":"108","severity":1,"message":"109","line":14,"column":13,"nodeType":"110","endLine":14,"endColumn":40},{"ruleId":"104","severity":1,"message":"111","line":2,"column":16,"nodeType":"106","messageId":"107","endLine":2,"endColumn":26},{"ruleId":"108","severity":1,"message":"109","line":20,"column":17,"nodeType":"110","endLine":20,"endColumn":96},{"ruleId":"108","severity":1,"message":"109","line":19,"column":21,"nodeType":"110","endLine":19,"endColumn":93},{"ruleId":"108","severity":1,"message":"109","line":20,"column":25,"nodeType":"110","endLine":20,"endColumn":76},{"ruleId":"108","severity":1,"message":"109","line":24,"column":25,"nodeType":"110","endLine":24,"endColumn":72},{"ruleId":"108","severity":1,"message":"109","line":28,"column":25,"nodeType":"110","endLine":28,"endColumn":71},{"ruleId":"108","severity":1,"message":"109","line":35,"column":25,"nodeType":"110","endLine":35,"endColumn":66},{"ruleId":"108","severity":1,"message":"109","line":39,"column":25,"nodeType":"110","endLine"